{
  "name": "mwave-mobile",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check:dependencies": "expo install --check",
    "bundle:ios": "expo export --platform ios --output-dir dist",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "build:ios:unsigned": "bash scripts/build-ios-unsigned.sh"
  },
  "dependencies": {
    "@expo-google-fonts/inter-tight": "0.4.2",
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo/metro-runtime": "6.1.2",
    "@noble/hashes": "1.8.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "54.0.37",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "15.0.9",
    "expo-file-system": "19.0.24",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.1.10",
    "jpeg-js": "0.4.4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
